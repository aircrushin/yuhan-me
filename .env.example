# ─── Database ────────────────────────────────────────────────────────────────
# Neon Postgres connection string (Settings → Connection details → "Direct connection").
# Locally you can use any Postgres DSN. Required.
DATABASE_URL=postgres://user:password@ep-xxx.neon.tech/aircrushin?sslmode=require

# ─── Admin authentication ────────────────────────────────────────────────────
# Owner password for the /admin login page. Required.
ADMIN_PASSWORD=change-me-please

# 32+ char random hex used to sign the admin session cookie. Required.
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-a-32-byte-random-hex

# ─── GitHub sync (optional) ──────────────────────────────────────────────────
# Personal access token with `public_repo` scope. Bumps API rate limit during
# the "Sync from GitHub" flow on the admin dashboard.
GITHUB_TOKEN=

# ─── Contact form email forwarding (optional) ────────────────────────────────
# If both are set, the public /contact form will forward submissions via Resend
# in addition to storing them in the messages table.
RESEND_API_KEY=
CONTACT_FORWARD_TO=
CONTACT_FROM="Portfolio <onboarding@resend.dev>"
